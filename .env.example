# Database (port 5434 to avoid conflict with system PostgreSQL)
DATABASE_URL=postgresql://localhost:5434/birdwatch
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Paths
MEDIA_DIR=media

# LLM/Embeddings
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# App
DEBUG=false
